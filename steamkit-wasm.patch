@@ -57,9 +57,16 @@ namespace DepotDownloader
                     using var fs = File.Open(filename, FileMode.Open, FileAccess.Read);
                     Instance = Serializer.Deserialize<AccountSettingsStore>(fs);
                 }
-                catch (IOException ex)
+                catch (Exception ex)
                 {
+                    // A corrupt store must never take down the runtime: older
+                    // builds saved with FileMode.OpenOrCreate (no truncation),
+                    // so a shrunk serialization leaves trailing garbage that
+                    // protobuf-net rejects with "Invalid wire-type". Drop the
+                    // corrupt file and continue logged-out; the user can log
+                    // in again and Save() will rewrite it cleanly.
                     Console.WriteLine("Failed to load account settings: {0}", ex.Message);
+                    try { File.Delete(filename); } catch { }
                     Instance = new AccountSettingsStore();
                 }
             }
